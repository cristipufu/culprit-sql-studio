          {
            "id": "activity",
            "every_seconds": 180,
            "jitter_seconds": 30,
            "collection": {
              "kind": "activity",
              "policy": {
                "blocked_after_ms": 30000,
                "running_after_ms": 60000,
                "update_every_ms": 300000
              }
            },
            "budget": {
              "page_rows": 250,
              "max_snapshot_rows": 500,
              "page_bytes": 4194304,
              "total_bytes": 67108864,
              "max_sql_bytes": 262144,
              "max_plan_bytes": 2097152,
              "max_pages": 32,
              "max_queries": 128,
              "statement_timeout_ms": 3000,
              "total_timeout_ms": 15000
            }
          },
          {
            "id": "query-history",
