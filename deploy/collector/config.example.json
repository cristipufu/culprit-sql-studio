        "tenant_id": "REPLACE_TENANT_ID",
        "client_id": "REPLACE_STAGING_CLIENT_ID",
        "token_file": "/var/run/secrets/culprit/token"
      }
    }
  },
  "source_credentials": {
    "pilot": "source"
