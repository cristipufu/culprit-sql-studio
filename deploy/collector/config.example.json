  "recovery": {
    "provider": "azure-blob",
    "options": {
      "account": "REPLACE_STORAGE_ACCOUNT",
      "container": "culprit-native",
      "prefix": "database-telemetry/pilot"
    },
    "credential": "recovery"
  },
  "target": {
    "kind": "adx",
    "query": {
      "endpoint": "https://REPLACE_CLUSTER.REGION.kusto.windows.net",
      "database": "REPLACE_ADX_DATABASE"
    },
    "ready": {
      "account": "REPLACE_STORAGE_ACCOUNT",
      "container": "culprit-ready",
      "prefix": "database-telemetry/pilot"
    },
    "credential": "analytics",
    "ready_credential": "staging"
  },
  "limits": {
    "max_bytes": 1073741824,
    "max_captures": 256
  },
  "credentials": {
    "source": {
      "kind": "azure",
      "identity": {
        "kind": "workload-identity",
        "tenant_id": "REPLACE_TENANT_ID",
        "client_id": "REPLACE_SOURCE_CLIENT_ID",
        "token_file": "/var/run/secrets/culprit/token"
      }
    },
    "recovery": {
      "kind": "azure",
      "identity": {
        "kind": "workload-identity",
        "tenant_id": "REPLACE_TENANT_ID",
