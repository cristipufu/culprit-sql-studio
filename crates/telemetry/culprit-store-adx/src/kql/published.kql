.create function CulpritPublishedV1(contract:string,store:string,resource:string,captured_from:datetime,asof:datetime) {
let Observations=materialize(
    CulpritPublishedRangesV1
    | where ContractId == contract and RecoveryStoreId == store and ResourceId == resource
    | where SchemaDigest == "$SCHEMA" and CollectedUntil >= captured_from and CollectedUntil <= asof
    | project $PROJECTION
    | distinct $COLUMNS
);
let Conflicts=Observations | summarize Variants=count() by RangeId | where Variants != 1 | project RangeId;
Observations
| join kind=leftanti Conflicts on RangeId
$RESTORE
}
