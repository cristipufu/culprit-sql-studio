{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Lint only: the code keeps its own formatting, and src/gen is generated from the Rust model.
  "files": { "includes": ["src/**", "!src/gen"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "css": { "linter": { "enabled": false } },
  "linter": {
    "enabled": true,
    // The groups that catch bugs, and accessibility; style is not enforced.
    "rules": {
      "preset": "none",
      "a11y": {
        "preset": "recommended",
        // Without a type a button submits whatever form it ends up in, including one a parent component renders.
        "useButtonType": "error",
        // Focus moves into a dialog, an inline confirmation or a rename field when the person opens it (the WAI-ARIA
        // dialog pattern); nothing takes focus on its own when a view loads.
        "noAutofocus": "off",
        // ARIA tables, radio groups and statuses on styled elements are accessible as written; swapping in native
        // elements would change the layout without changing what a screen reader says.
        "useSemanticElements": "off",
        // These flag containers: backdrops that close on a click (Escape closes them from the keyboard), drop zones
        // (Paste or Open does the same), composite widgets whose key handlers serve their focusable children, menus
        // that keep their clicks inside. A click without keys, or a control that can't take focus, is still an
        // error: useKeyWithClickEvents and useFocusableInteractive stay on.
        "noStaticElementInteractions": "off",
        "noNoninteractiveElementInteractions": "off"
      },
      "correctness": {
        "preset": "recommended",
        // A missing dependency is a stale closure. An extra one is how an effect reruns when a key changes, which
        // React's own rule allows too.
        "useExhaustiveDependencies": { "level": "error", "options": { "reportUnnecessaryDependencies": false } },
        // New in the recommended set with Biome 2.6. It takes any capitalised object property holding a function for a
        // component, so it reports the key names of every useHotkeys map (Escape, ArrowDown, Enter) and found nothing
        // else: biomejs/biome#12625, open. Turn it back on once that is fixed.
        "noComponentHookFactories": "off"
      },
      "suspicious": {
        "preset": "recommended",
        // Index keys here are on lists rebuilt whole from a report or a result, never reordered with state per item.
        "noArrayIndexKey": "off",
        // A callback that must return (map, filter, find) still has to; `forEach(x => set.add(x))` may.
        "useIterableCallbackReturn": { "level": "error", "options": { "checkForEach": false } }
      },
      "complexity": {
        "preset": "recommended",
        // `() => (act(), true)` is the house idiom for one-line handlers and CodeMirror commands.
        "noCommaOperator": "off"
      }
    },
    "domains": { "react": "recommended" }
  }
}
