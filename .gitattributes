# LF everywhere, including Windows checkouts: tests parse fixture text (plans, EXPLAIN output, deadlock graphs).
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.sqlplan text eol=lf

# Language catalogs merge key by key (docs/localization.md, "Merging catalogs").
locales/*.json merge=catalog

# ts-rs emits spaces before field documentation; preserve its generated output verbatim.
app/src/gen/*.ts whitespace=-blank-at-eol linguist-generated=true

# CLI output pins retain fixed-width column padding verbatim.
crates/culprit-cli/tests/said/*.txt whitespace=-blank-at-eol
